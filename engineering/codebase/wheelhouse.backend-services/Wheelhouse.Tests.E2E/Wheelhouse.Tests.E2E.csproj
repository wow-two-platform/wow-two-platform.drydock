<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
        <IsTestProject>true</IsTestProject>
    </PropertyGroup>

    <!--
      E2E integration tests — boots the real Wheelhouse.Api host in-process via WebApplicationFactory<Program>
      against an ephemeral Postgres container (Testcontainers); migrate-on-boot (the bespoke SQL migrator)
      builds the schema.

      Harness now rides the SDK testing package (WoW2.Sdk.Backend.Beta.Testing): WebApiTestHost<Program>,
      PostgresFixture (Testcontainers + Respawn), and the Web JSON/envelope helpers all come from it. It
      transitively brings Microsoft.AspNetCore.Mvc.Testing, xunit, AwesomeAssertions, Testcontainers.PostgreSql,
      Respawn + Npgsql — so only the test RUNNER (which the helper package deliberately omits) is referenced here.
      Wheelhouse-specific bits that stay local: the test-admin policy rebind onto the SDK test-auth scheme and
      WheelhouseAppFixture (DB lifecycle composing PostgresFixture). The GitHub/GHCR fakes + the header-gated
      test-auth handler now come from the SDK (Testing.Integrations + Testing.Auth).
    -->
    <ItemGroup>
        <PackageReference Include="WoW2.Sdk.Backend.Beta.Testing" Version="10.0.40-beta"/>
        <!-- SDK integration-client fakes (FakeGitHubClient / FakeContainerRegistryClient) replacing the local stubs. -->
        <PackageReference Include="WoW2.Sdk.Backend.Beta.Testing.Integrations" Version="10.0.40-beta"/>
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0"/>
        <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Wheelhouse.Api\Wheelhouse.Api.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <Using Include="Xunit"/>
    </ItemGroup>

</Project>

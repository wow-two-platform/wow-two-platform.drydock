{
  "name": "wheelhouse-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=24.11.0 <25"
  },
  "scripts": {
    "dev": "pnpm --filter @wheelhouse/web dev",
    "dev:http": "pnpm --filter @wheelhouse/web dev:http",
    "build": "pnpm -r --if-present build",
    "deploy": "node scripts/deploy.mjs",
    "preview": "pnpm --filter @wheelhouse/web preview",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "format": "pnpm -r --if-present format"
  }
}
